{
	"name": "NextBuildStudio",
	"build": {
		"context": "..",
		"dockerfile": "Dockerfile"
	},
	"features": {
		"ghcr.io/devcontainers/features/desktop-lite:1": {
			"password": "speccy",
			"webPort": "6080",
			"vncPort": "5901"
		}
	},
	"forwardPorts": [
		5901,
		6080
	],
	"postCreateCommand": "bash scripts/install.sh",
	"customizations": {
		"vscode": {
			"extensions": [
				"em00k.nextbuild",
				"eliverlara.andromeda",
				"maziac.nex-fileviewer",
				"maziac.asm-code-lens",
				"alefragnani.bookmarks",
				"commandvariable.dateTime",
				"vscodevim.vim"
			]
		}
	},
	"remoteUser": "vscode"
}